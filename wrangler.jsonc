{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duck-hunt-dublin-live",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [ { "name": "DUCK_ROOMS", "class_name": "DuckHuntRoom" } ] },
  "exports": { "DuckHuntRoom": { "type": "durable-object", "storage": "sqlite" } }
}
